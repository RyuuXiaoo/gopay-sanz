<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>SANZ CLOUD PLATFORM</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            200: '#b9dffd',
                            300: '#7cc5fb',
                            400: '#36a7f6',
                            500: '#0c8ce7',
                            600: '#006fc5',
                            700: '#0158a0',
                            800: '#064b84',
                            900: '#0b3f6e',
                            950: '#072849',
                        }
                    },
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'gradient': 'gradient 8s ease infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                        gradient: {
                            '0%, 100%': { backgroundPosition: '0% 50%' },
                            '50%': { backgroundPosition: '100% 50%' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: #050a14;
            min-height: 100vh;
        }

        .bg-mesh {
            background-color: #050a14;
            background-image: 
                radial-gradient(at 20% 20%, rgba(12, 140, 231, 0.15) 0px, transparent 50%),
                radial-gradient(at 80% 10%, rgba(99, 102, 241, 0.12) 0px, transparent 45%),
                radial-gradient(at 50% 80%, rgba(6, 182, 212, 0.1) 0px, transparent 50%),
                radial-gradient(at 90% 70%, rgba(139, 92, 246, 0.08) 0px, transparent 40%);
        }

        .glass {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(148, 163, 184, 0.08);
        }

        .glass-card {
            background: linear-gradient(145deg, rgba(15, 23, 42, 0.85) 0%, rgba(15, 23, 42, 0.65) 100%);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(148, 163, 184, 0.1);
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            border-color: rgba(12, 140, 231, 0.35);
            box-shadow: 0 0 0 1px rgba(12, 140, 231, 0.1), 0 20px 40px -15px rgba(0, 0, 0, 0.5), 0 0 30px -10px rgba(12, 140, 231, 0.15);
            transform: translateY(-3px);
        }

        .input-field {
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid rgba(148, 163, 184, 0.12);
            color: #e2e8f0;
            transition: all 0.2s ease;
            font-family: 'Inter', sans-serif;
        }

        .input-field:focus {
            background: rgba(15, 23, 42, 0.95);
            border-color: #0c8ce7;
            box-shadow: 0 0 0 3px rgba(12, 140, 231, 0.15);
            outline: none;
        }

        .input-field::placeholder {
            color: #64748b;
        }

        .endpoint-box {
            background: rgba(2, 6, 23, 0.85);
            border: 1px solid rgba(30, 41, 59, 0.8);
            color: #94a3b8;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            border-radius: 12px;
            padding: 0.7rem 1rem;
            display: flex;
            align-items: center;
            overflow-x: auto;
            white-space: nowrap;
        }

        .endpoint-box .method {
            color: #38bdf8;
            font-weight: 600;
            margin-right: 0.6rem;
            flex-shrink: 0;
        }

        .result-box {
            display: none;
            background: rgba(2, 6, 23, 0.9);
            border: 1px solid rgba(30, 41, 59, 0.9);
            border-radius: 12px;
            margin-top: 1rem;
            padding: 1rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            color: #34d399;
            max-height: 280px;
            overflow-y: auto;
            line-height: 1.55;
        }

        .result-box.error {
            color: #f87171;
        }

        .btn-primary {
            background: linear-gradient(135deg, #0c8ce7 0%, #006fc5 100%);
            color: white;
            font-weight: 600;
            transition: all 0.25s ease;
            position: relative;
            overflow: hidden;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #36a7f6 0%, #0c8ce7 100%);
            box-shadow: 0 8px 25px -8px rgba(12, 140, 231, 0.55);
            transform: translateY(-1px);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn-purple {
            background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
        }
        .btn-purple:hover {
            background: linear-gradient(135deg, #a78bfa 0%, #8b5cf6 100%);
            box-shadow: 0 8px 25px -8px rgba(139, 92, 246, 0.55);
        }

        .btn-amber {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        }
        .btn-amber:hover {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
            box-shadow: 0 8px 25px -8px rgba(245, 158, 11, 0.55);
        }

        .btn-emerald {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }
        .btn-emerald:hover {
            background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
            box-shadow: 0 8px 25px -8px rgba(16, 185, 129, 0.55);
        }

        .btn-cyan {
            background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
        }
        .btn-cyan:hover {
            background: linear-gradient(135deg, #22d3ee 0%, #06b6d4 100%);
            box-shadow: 0 8px 25px -8px rgba(6, 182, 212, 0.55);
        }

        .btn-rose {
            background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
        }
        .btn-rose:hover {
            background: linear-gradient(135deg, #fb7185 0%, #f43f5e 100%);
            box-shadow: 0 8px 25px -8px rgba(244, 63, 94, 0.55);
        }

        .icon-box {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .step-tag {
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            padding: 2px 9px;
            border-radius: 9999px;
            background: rgba(12, 140, 231, 0.15);
            color: #38bdf8;
            border: 1px solid rgba(12, 140, 231, 0.25);
        }

        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }

        .toast-container {
            position: fixed;
            bottom: 28px;
            right: 28px;
            z-index: 9999;
            pointer-events: none;
        }

        .toast {
            background: rgba(15, 23, 42, 0.95);
            color: #f1f5f9;
            font-size: 0.8125rem;
            font-weight: 500;
            padding: 14px 20px;
            border-radius: 14px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
            display: flex;
            align-items: center;
            gap: 10px;
            opacity: 0;
            transform: translateY(20px) scale(0.95);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            pointer-events: auto;
            border: 1px solid rgba(148, 163, 184, 0.15);
            backdrop-filter: blur(12px);
        }

        .toast.show {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        .logo-glow {
            box-shadow: 0 0 30px rgba(12, 140, 231, 0.4), 0 0 60px rgba(12, 140, 231, 0.15);
        }

        .nav-blur {
            background: rgba(5, 10, 20, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(148, 163, 184, 0.06);
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #10b981;
            box-shadow: 0 0 8px #10b981;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .hero-title {
            background: linear-gradient(135deg, #f1f5f9 0%, #94a3b8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .brand-gradient {
            background: linear-gradient(135deg, #38bdf8 0%, #0c8ce7 40%, #6366f1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="bg-mesh text-slate-200 antialiased">

    <!-- Navbar -->
    <nav class="nav-blur fixed top-0 w-full z-50">
        <div class="max-w-7xl mx-auto px-5 sm:px-6 h-[72px] flex items-center justify-between">
            <div class="flex items-center gap-3">
                <img src="/logo.png" alt="SANZ CLOUD" class="w-11 h-11 rounded-full object-cover logo-glow ring-2 ring-sky-500/40">
                <div>
                    <h1 class="text-[15px] sm:text-base font-bold tracking-tight text-white leading-tight">SANZ CLOUD</h1>
                    <p class="text-[10px] sm:text-[11px] font-medium text-sky-400/90 tracking-wider uppercase">Platform</p>
                </div>
            </div>
            <div class="flex items-center gap-3 sm:gap-5">
                <div class="hidden sm:flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20">
                    <span class="status-dot"></span>
                    <span class="text-xs font-medium text-emerald-400">Live</span>
                </div>
                <a href="https://t.me/SANZCVPUBLIKK" target="_blank" class="w-9 h-9 rounded-xl bg-slate-800/80 border border-slate-700/50 flex items-center justify-center text-slate-400 hover:text-sky-400 hover:border-sky-500/30 transition">
                    <i class="fa-brands fa-telegram text-sm"></i>
                </a>
            </div>
        </div>
    </nav>

    <!-- Hero -->
    <section class="max-w-7xl mx-auto px-5 sm:px-6 pt-28 pb-10 sm:pt-32 sm:pb-12">
        <div class="text-center max-w-2xl mx-auto">
            <div class="relative inline-block mb-6">
                <div class="absolute inset-0 bg-sky-500/20 rounded-full blur-2xl scale-110"></div>
                <img src="/logo.png" alt="SANZ CLOUD PLATFORM" class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-full object-cover mx-auto ring-2 ring-sky-400/30 shadow-[0_0_40px_rgba(12,140,231,0.35)]">
            </div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-medium mb-4">
                <i class="fa-solid fa-bolt text-[10px]"></i>
                Payment Gateway Explorer
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight hero-title mb-3">
                SANZ <span class="brand-gradient">CLOUD</span> PLATFORM
            </h2>
            <p class="text-slate-400 text-sm sm:text-[15px] leading-relaxed max-w-lg mx-auto mb-1">
                Powerful. Secure. Scalable.
            </p>
            <p class="text-slate-500 text-xs sm:text-sm leading-relaxed max-w-md mx-auto">
                Interface modern untuk mengelola autentikasi, QRIS, dan transaksi melalui GoMerchant API.
            </p>
        </div>
    </section>

    <!-- Main Cards -->
    <main class="max-w-7xl mx-auto px-5 sm:px-6 pb-20">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">

            <!-- Card 1: Auth OTP -->
            <div class="glass-card rounded-2xl p-6 sm:p-7">
                <div class="flex items-center gap-3.5 mb-5">
                    <div class="icon-box bg-violet-500/15 text-violet-400 border border-violet-500/20">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2.5 flex-wrap">
                            <h3 class="text-[15px] font-semibold text-white">Auth OTP</h3>
                            <span class="step-tag">STEP 1</span>
                        </div>
                        <p class="text-xs text-slate-500 mt-0.5">Kirim kode OTP via email / nomor telepon</p>
                    </div>
                </div>

                <div class="endpoint-box mb-5">
                    <span class="method">GET</span>
                    <span id="urlAuthOtp" class="truncate">loading...</span>
                    <button onclick="copyUrl('urlAuthOtp')" class="ml-auto pl-3 text-slate-500 hover:text-sky-400 transition shrink-0">
                        <i class="fa-regular fa-copy"></i>
                    </button>
                </div>

                <form id="formAuthOtp" class="space-y-4">
                    <div>
                        <label class="text-[11px] font-medium text-slate-500 uppercase tracking-wider ml-0.5 mb-1.5 block">Email / Nomor Telepon</label>
                        <input type="text" id="paramAuthOtpCredential" placeholder="user@gmail.com atau 628xxx" class="input-field w-full rounded-xl px-4 py-3 text-sm">
                    </div>
                    <button type="submit" class="btn-primary btn-purple w-full py-3 rounded-xl text-sm">
                        <i class="fa-solid fa-paper-plane mr-2 text-xs"></i>Request OTP
                    </button>
                </form>
                <pre id="resAuthOtp" class="result-box"></pre>
            </div>

            <!-- Card 2: Verify OTP -->
            <div class="glass-card rounded-2xl p-6 sm:p-7">
                <div class="flex items-center gap-3.5 mb-5">
                    <div class="icon-box bg-amber-500/15 text-amber-400 border border-amber-500/20">
                        <i class="fa-solid fa-key"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2.5 flex-wrap">
                            <h3 class="text-[15px] font-semibold text-white">Verify OTP</h3>
                            <span class="step-tag">STEP 2</span>
                        </div>
                        <p class="text-xs text-slate-500 mt-0.5">Verifikasi OTP untuk mendapatkan access token</p>
                    </div>
                </div>

                <div class="endpoint-box mb-5">
                    <span class="method">GET</span>
                    <span id="urlAuthVerify" class="truncate">loading...</span>
                    <button onclick="copyUrl('urlAuthVerify')" class="ml-auto pl-3 text-slate-500 hover:text-sky-400 transition shrink-0">
                        <i class="fa-regular fa-copy"></i>
                    </button>
                </div>

                <form id="formAuthVerify" class="space-y-4">
                    <div>
                        <label class="text-[11px] font-medium text-slate-500 uppercase tracking-wider ml-0.5 mb-1.5 block">Kode OTP</label>
                        <input type="text" id="paramAuthVerifyOtp" placeholder="1234" class="input-field w-full rounded-xl px-4 py-3 text-sm">
                    </div>
                    <div>
                        <label class="text-[11px] font-medium text-slate-500 uppercase tracking-wider ml-0.5 mb-1.5 block">OTP Token</label>
                        <input type="text" id="paramAuthVerifyOtpToken" placeholder="token_dari_request_otp" class="input-field w-full rounded-xl px-4 py-3 text-sm">
                    </div>
                    <button type="submit" class="btn-primary btn-amber w-full py-3 rounded-xl text-sm">
                        <i class="fa-solid fa-check-double mr-2 text-xs"></i>Verifikasi OTP
                    </button>
                </form>
                <pre id="resAuthVerify" class="result-box"></pre>
            </div>

            <!-- Card 3: Create QRIS -->
            <div class="glass-card rounded-2xl p-6 sm:p-7">
                <div class="flex items-center gap-3.5 mb-5">
                    <div class="icon-box bg-sky-500/15 text-sky-400 border border-sky-500/20">
                        <i class="fa-solid fa-qrcode"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-[15px] font-semibold text-white">Create QRIS Payment</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Generate QRIS dinamis dari static QR</p>
                    </div>
                </div>

                <div class="endpoint-box mb-5">
                    <span class="method">GET</span>
                    <span id="urlQrisCreate" class="truncate">loading...</span>
                    <button onclick="copyUrl('urlQrisCreate')" class="ml-auto pl-3 text-slate-500 hover:text-sky-400 transition shrink-0">
                        <i class="fa-regular fa-copy"></i>
                    </button>
                </div>

                <form id="formQrisCreate" class="space-y-4">
                    <div>
                        <label class="text-[11px] font-medium text-slate-500 uppercase tracking-wider ml-0.5 mb-1.5 block">Amount</label>
                        <input type="number" id="paramQrisAmount" placeholder="50000" class="input-field w-full rounded-xl px-4 py-3 text-sm">
                    </div>
                    <div>
                        <label class="text-[11px] font-medium text-slate-500 uppercase tracking-wider ml-0.5 mb-1.5 block">Static QR</label>
                        <input type="text" id="paramQrisStaticQr" placeholder="000201010212..." class="input-field w-full rounded-xl px-4 py-3 text-sm">
                    </div>
                    <button type="submit" class="btn-primary w-full py-3 rounded-xl text-sm">
                        <i class="fa-solid fa-qrcode mr-2 text-xs"></i>Buat QRIS
                    </button>
                </form>
                <pre id="resQrisCreate" class="result-box"></pre>
            </div>

            <!-- Card 4: History -->
            <div class="glass-card rounded-2xl p-6 sm:p-7">
                <div class="flex items-center gap-3.5 mb-5">
                    <div class="icon-box bg-emerald-500/15 text-emerald-400 border border-emerald-500/20">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-[15px] font-semibold text-white">Transaction History</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Riwayat transaksi 7 hari terakhir</p>
                    </div>
                </div>

                <div class="endpoint-box mb-5">
                    <span class="method">GET</span>
                    <span id="urlHistory" class="truncate">loading...</span>
                    <button onclick="copyUrl('urlHistory')" class="ml-auto pl-3 text-slate-500 hover:text-sky-400 transition shrink-0">
                        <i class="fa-regular fa-copy"></i>
                    </button>
                </div>

                <form id="formHistory" class="space-y-4">
                    <div>
                        <label class="text-[11px] font-medium text-slate-500 uppercase tracking-wider ml-0.5 mb-1.5 block">Access Token</label>
                        <input type="text" id="paramHistoryToken" placeholder="access_token_anda" class="input-field w-full rounded-xl px-4 py-3 text-sm">
                    </div>
                    <div>
                        <label class="text-[11px] font-medium text-slate-500 uppercase tracking-wider ml-0.5 mb-1.5 block">Tanggal Mulai <span class="text-slate-600 normal-case">(opsional)</span></label>
                        <input type="text" id="paramHistoryStartTime" placeholder="YYYY-MM-DD" class="input-field w-full rounded-xl px-4 py-3 text-sm">
                    </div>
                    <button type="submit" class="btn-primary btn-emerald w-full py-3 rounded-xl text-sm">
                        <i class="fa-solid fa-clock-rotate-left mr-2 text-xs"></i>Lihat Riwayat
                    </button>
                </form>
                <pre id="resHistory" class="result-box"></pre>
            </div>

            <!-- Card 5: Refresh Token -->
            <div class="glass-card rounded-2xl p-6 sm:p-7">
                <div class="flex items-center gap-3.5 mb-5">
                    <div class="icon-box bg-cyan-500/15 text-cyan-400 border border-cyan-500/20">
                        <i class="fa-solid fa-rotate"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-[15px] font-semibold text-white">Refresh Token</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Dapatkan access token baru</p>
                    </div>
                </div>

                <div class="endpoint-box mb-5">
                    <span class="method">GET</span>
                    <span id="urlRefreshToken" class="truncate">loading...</span>
                    <button onclick="copyUrl('urlRefreshToken')" class="ml-auto pl-3 text-slate-500 hover:text-sky-400 transition shrink-0">
                        <i class="fa-regular fa-copy"></i>
                    </button>
                </div>

                <form id="formRefreshToken" class="space-y-4">
                    <div>
                        <label class="text-[11px] font-medium text-slate-500 uppercase tracking-wider ml-0.5 mb-1.5 block">Refresh Token</label>
                        <input type="text" id="paramRefreshToken" placeholder="refresh_token_anda" class="input-field w-full rounded-xl px-4 py-3 text-sm">
                    </div>
                    <button type="submit" class="btn-primary btn-cyan w-full py-3 rounded-xl text-sm">
                        <i class="fa-solid fa-arrows-rotate mr-2 text-xs"></i>Refresh Token
                    </button>
                </form>
                <pre id="resRefreshToken" class="result-box"></pre>
            </div>

            <!-- Card 6: Validate Token -->
            <div class="glass-card rounded-2xl p-6 sm:p-7">
                <div class="flex items-center gap-3.5 mb-5">
                    <div class="icon-box bg-rose-500/15 text-rose-400 border border-rose-500/20">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-[15px] font-semibold text-white">Validate Token</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Cek apakah access token masih valid</p>
                    </div>
                </div>

                <div class="endpoint-box mb-5">
                    <span class="method">GET</span>
                    <span id="urlCheckToken" class="truncate">loading...</span>
                    <button onclick="copyUrl('urlCheckToken')" class="ml-auto pl-3 text-slate-500 hover:text-sky-400 transition shrink-0">
                        <i class="fa-regular fa-copy"></i>
                    </button>
                </div>

                <form id="formCheckToken" class="space-y-4">
                    <div>
                        <label class="text-[11px] font-medium text-slate-500 uppercase tracking-wider ml-0.5 mb-1.5 block">Access Token</label>
                        <input type="text" id="paramCheckToken" placeholder="access_token_anda" class="input-field w-full rounded-xl px-4 py-3 text-sm">
                    </div>
                    <button type="submit" class="btn-primary btn-rose w-full py-3 rounded-xl text-sm">
                        <i class="fa-solid fa-shield-halved mr-2 text-xs"></i>Cek Validitas
                    </button>
                </form>
                <pre id="resCheckToken" class="result-box"></pre>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/60">
        <div class="max-w-7xl mx-auto px-5 sm:px-6 py-8 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <img src="/logo.png" alt="SANZ CLOUD" class="w-9 h-9 rounded-full object-cover ring-1 ring-sky-500/30">
                <div>
                    <p class="text-sm font-semibold text-slate-300">SANZ CLOUD PLATFORM</p>
                    <p class="text-[11px] text-slate-600">© 2026 · Powerful. Secure. Scalable.</p>
                </div>
            </div>
            <div class="flex items-center gap-4 text-slate-500">
                <a href="https://t.me/SANZCVPUBLIKK" target="_blank" class="hover:text-sky-400 transition text-lg" title="Telegram">
                    <i class="fa-brands fa-telegram"></i>
                </a>
            </div>
        </div>
    </footer>

    <!-- Toast -->
    <div class="toast-container">
        <div id="toast" class="toast">
            <span class="toast-icon">✓</span>
            <span id="toast-msg">Copied!</span>
        </div>
    </div>

    <script>
        const BASE_URL = window.location.origin;

        function getVal(id) {
            const el = document.getElementById(id);
            return el ? el.value.trim() : '';
        }

        let toastTimer;

        function showToast(message, icon = '✓') {
            const toast = document.getElementById('toast');
            const msg = document.getElementById('toast-msg');
            const iconEl = toast.querySelector('.toast-icon');
            iconEl.textContent = icon;
            msg.textContent = message;
            toast.classList.add('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.remove('show');
            }, 2200);
        }

        async function copyUrl(id) {
            const text = document.getElementById(id).innerText;
            try {
                await navigator.clipboard.writeText(text);
                showToast('Endpoint URL disalin!', '📋');
            } catch {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try {
                    document.execCommand('copy');
                    showToast('Endpoint URL disalin!', '📋');
                } catch (e) {
                    showToast('Gagal menyalin. Salin manual.', '⚠️');
                }
                document.body.removeChild(ta);
            }
        }

        function updateAllUrls() {
            const otpCred = getVal('paramAuthOtpCredential');
            const otpParam = otpCred.includes('@') ? 'email' : 'phone';
            const otpQuery = otpCred ? `?${otpParam}=${encodeURIComponent(otpCred)}` : '?{email_or_phone}';
            document.getElementById('urlAuthOtp').innerText = `${BASE_URL}/auth/otp${otpQuery}`;

            const verifyOtp = getVal('paramAuthVerifyOtp') || '{otp}';
            const verifyOtpToken = getVal('paramAuthVerifyOtpToken') || '{otp_token}';
            document.getElementById('urlAuthVerify').innerText =
                `${BASE_URL}/auth/verify?otp=${encodeURIComponent(verifyOtp)}&otp_token=${encodeURIComponent(verifyOtpToken)}`;

            const qrisAmount = getVal('paramQrisAmount') || '{amount}';
            const qrisStatic = getVal('paramQrisStaticQr') || '{static_qr}';
            document.getElementById('urlQrisCreate').innerText =
                `${BASE_URL}/api/qris/create?amount=${encodeURIComponent(qrisAmount)}&static_qr=${encodeURIComponent(qrisStatic)}`;

            const histToken = getVal('paramHistoryToken') || '{token}';
            const histStart = getVal('paramHistoryStartTime');
            const histQuery = histStart ?
                `?token=${encodeURIComponent(histToken)}&start_time=${encodeURIComponent(histStart)}` :
                `?token=${encodeURIComponent(histToken)}`;
            document.getElementById('urlHistory').innerText = `${BASE_URL}/api/history${histQuery}`;

            const refreshToken = getVal('paramRefreshToken') || '{refresh_token}';
            document.getElementById('urlRefreshToken').innerText =
                `${BASE_URL}/auth/refresh/token?refresh_token=${encodeURIComponent(refreshToken)}`;

            const checkToken = getVal('paramCheckToken') || '{token}';
            document.getElementById('urlCheckToken').innerText =
                `${BASE_URL}/auth/check/token?token=${encodeURIComponent(checkToken)}`;
        }

        document.querySelectorAll('input').forEach(el => {
            el.addEventListener('input', updateAllUrls);
            el.addEventListener('change', updateAllUrls);
        });

        async function fetchGET(url, params = {}) {
            Object.keys(params).forEach(k => {
                if (params[k] === '' || params[k] === null || params[k] === undefined) {
                    delete params[k];
                }
            });
            const query = new URLSearchParams(params).toString();
            const fullUrl = query ? `${url}?${query}` : url;
            try {
                const res = await fetch(fullUrl);
                const data = await res.json();
                return data;
            } catch (error) {
                return {
                    success: false,
                    error_type: "Network / CORS Error",
                    message: error.message,
                    attempted_url: fullUrl,
                    hint: "Pastikan backend server berjalan dan mengizinkan CORS."
                };
            }
        }

        async function executeApi(endpoint, params, resultElementId) {
            const resBox = document.getElementById(resultElementId);
            resBox.style.display = 'block';
            resBox.className = 'result-box';
            resBox.innerHTML = '<span style="color:#64748b">// Processing request...</span>';

            try {
                const res = await fetchGET(endpoint, params);
                if (res.error_type === "Network / CORS Error") {
                    resBox.classList.add('error');
                }
                resBox.innerHTML = JSON.stringify(res, null, 2);
            } catch (err) {
                resBox.classList.add('error');
                resBox.innerHTML = '// Error: ' + err.message;
            }
        }

        document.getElementById('formAuthOtp').onsubmit = async function(e) {
            e.preventDefault();
            const credential = getVal('paramAuthOtpCredential');
            const resBox = document.getElementById('resAuthOtp');
            if (!credential) {
                resBox.style.display = 'block';
                resBox.className = 'result-box error';
                resBox.innerHTML = JSON.stringify({
                    success: false,
                    error: 'Email atau nomor telepon wajib diisi'
                }, null, 2);
                return;
            }
            const isEmail = credential.includes('@');
            const params = isEmail ? { email: credential } : { phone: credential };
            await executeApi('/auth/otp', params, 'resAuthOtp');
        };

        document.getElementById('formAuthVerify').onsubmit = async function(e) {
            e.preventDefault();
            const params = {
                otp: getVal('paramAuthVerifyOtp'),
                otp_token: getVal('paramAuthVerifyOtpToken')
            };
            await executeApi('/auth/verify', params, 'resAuthVerify');
        };

        document.getElementById('formQrisCreate').onsubmit = async function(e) {
            e.preventDefault();
            const params = {
                amount: getVal('paramQrisAmount'),
                static_qr: getVal('paramQrisStaticQr')
            };
            await executeApi('/api/qris/create', params, 'resQrisCreate');
        };

        document.getElementById('formHistory').onsubmit = async function(e) {
            e.preventDefault();
            const params = {
                token: getVal('paramHistoryToken'),
                start_time: getVal('paramHistoryStartTime')
            };
            await executeApi('/api/history', params, 'resHistory');
        };

        document.getElementById('formRefreshToken').onsubmit = async function(e) {
            e.preventDefault();
            const params = {
                refresh_token: getVal('paramRefreshToken')
            };
            await executeApi('/auth/refresh/token', params, 'resRefreshToken');
        };

        document.getElementById('formCheckToken').onsubmit = async function(e) {
            e.preventDefault();
            const params = {
                token: getVal('paramCheckToken')
            };
            await executeApi('/auth/check/token', params, 'resCheckToken');
        };

        updateAllUrls();
    </script>
</body>
</html>
